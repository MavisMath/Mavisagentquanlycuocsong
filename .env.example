# ==========================================
# MAVIS AI EXECUTIVE LIFE COACH - ENV TEMPLATE
# Copy file này thành .env hoặc nạp vào Cloud Secrets
# ==========================================

# 1. Google Gemini API (Bắt buộc)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Tavily Search API (Khuyến nghị cho trinh sát xu hướng & tài nguyên)
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Google Calendar API (Tùy chọn - nếu tích hợp đồng bộ lịch thực)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.json

# 4. Twilio SMS / WhatsApp (Tùy chọn - nếu thông báo khẩn cấp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
